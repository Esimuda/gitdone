# Leave both unset to show sample journeys for this repository (badge: Sample data).
# Set both to read the real GitLab project. Pass a numeric id or a raw path (group/project).
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
# Optional. Defaults to https://gitlab.com
GITLAB_BASE_URL=
# Optional. When set, POST /api/subscribe forwards { "email" } here. The form is not linked from the app.
SUBSCRIBE_WEBHOOK_URL=

# Sign in with GitLab (OAuth application, confidential, scopes read_user and api).
# Redirect URI: {GITDONE_PUBLIC_URL}/api/auth/callback
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Encrypts the session cookie. Any string. SHA-256 is the key.
GITDONE_SESSION_SECRET=
# Encrypts GitLab tokens at rest. Base64 32-byte key, or any other secret (SHA-256).
GITDONE_TOKEN_KEY=
# Public origin with no trailing slash. Required in production so the OAuth redirect matches.
GITDONE_PUBLIC_URL=
# Local only. End users do not paste tokens.
# GITDONE_ALLOW_TOKEN_PASTE=true
# Postgres in production. Unset locally to use SQLite in .data/
# DATABASE_URL=
# Optional. Project path whose ci/gitdone.gitlab-ci.yml other projects include.
# Defaults to gitlab-ai-hackathon/transcend-october-2026/43073569/gitdone
GITDONE_CI_PROJECT=
# Optional. Directory for the SQLite file. Defaults to .data
GITDONE_DATA_DIR=
