# Leave both unset to run the seeded demo.
# Set both to read a real GitLab project. Pass a numeric id or a raw path (group/project).
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
# Optional. Defaults to https://gitlab.com
GITLAB_BASE_URL=
# Optional. When set, POST /api/subscribe forwards { "email" } here. Otherwise the address stays in the browser.
SUBSCRIBE_WEBHOOK_URL=
